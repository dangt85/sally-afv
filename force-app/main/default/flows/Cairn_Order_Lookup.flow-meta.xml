    <environments>Default</environments>
    <formulas>
        <name>HasKnownAccount</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!AccountIdInput}))</expression>
    </formulas>
    <formulas>
        <name>HasOrderNumber</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!OrderNumberInput}))</expression>
    </formulas>
    <formulas>
        <name>HasOrderProof</name>
        <dataType>Boolean</dataType>
        <expression
    >AND(NOT(ISBLANK({!OrderNumberInput})), NOT(ISBLANK({!OrderDateInput})))</expression>
    </formulas>
    <formulas>
        <name>OrderSummaryFormula</name>
        <dataType>String</dataType>
        <expression
    >"order " &amp; {!OrderNumberOutput} &amp; ", total $" &amp; TEXT({!TotalAmountOutput}) &amp; ", fulfillment status " &amp; BLANKVALUE({!FulfillmentStatusOutput}, "") &amp; ", estimated delivery " &amp; IF(ISBLANK({!EstimatedDeliveryDateOutput}), "", TEXT({!EstimatedDeliveryDateOutput}))</expression>
    </formulas>
