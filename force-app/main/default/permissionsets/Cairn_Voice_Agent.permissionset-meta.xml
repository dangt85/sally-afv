<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Cairn Voice Agent</label>
    <description
  >Runtime access for the Cairn Compass Agentforce Voice agent's default agent user — order lookup (Apex + Data Cloud data graph), product Q&amp;A (Apex vector search), company FAQ (Knowledge via Answer Questions with Knowledge), and case creation.</description>
    <classAccesses>
        <apexClass>OrderLookupDataGraph</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ProductQnAVectorSearch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <flowAccesses>
        <flow>Cairn_Order_Lookup</flow>
        <enabled>true</enabled>
    </flowAccesses>
    <flowAccesses>
        <flow>Cairn_Create_Case</flow>
        <enabled>true</enabled>
    </flowAccesses>
    <fieldPermissions>
        <field>Order.Fulfillment_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Order.Estimated_Delivery_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Knowledge__kav.FAQ_Question__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Knowledge__kav.FAQ_Answer__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Knowledge__kav.Chat_Answer__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <object>Order</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Account</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Case</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Knowledge__kav</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
</PermissionSet>
